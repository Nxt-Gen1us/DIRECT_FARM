# ── DIRECT FARM Frontend Environment ─────────────────────────────────────────
# Backend REST API base URL. Must end WITHOUT a trailing slash.
VITE_API_URL=http://localhost:5000/api/v1

# Socket.io server URL for real-time chat (optional – leave blank to use REST polling)
VITE_SOCKET_URL=http://localhost:5000

# Razorpay Key ID (optional – leave blank to enable COD-only mode)
VITE_RAZORPAY_KEY_ID=
